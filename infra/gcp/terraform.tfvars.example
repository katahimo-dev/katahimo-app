# cp terraform.tfvars.example terraform.tfvars(terraform.tfvars はコミットしない)
project_id = "katahimo-prod"
region     = "asia-northeast1"

# 初回は false。ロール作成・シークレット登録・イメージの push の後に true にして再度 apply(doc/07_インフラ・運用.md 3章)
deploy_workloads = false

sql_tier              = "db-g1-small"
sql_high_availability = false

schedule_provider          = "google"
gas_bridge_url             = ""
mirror_to_google_sheets    = false
customer_csv_drive_folders = "{\"cutest\":\"<DriveフォルダID>\"}"

app_public_url = "https://app.example.jp"

smtp = {
  host = "smtp.gmail.com"
  port = 587
  user = "noreply@example.com"
  from = "保育日報 <noreply@example.com>"
}

# Web Push(翌日の予定のお知らせ)。pnpm push:vapid-keys の公開鍵と連絡先。秘密鍵は Secret Manager の
# vapid-private-key に登録し、optional_secrets に足す(使わないなら3つとも空・外す)
web_push = {
  public_key = "<VAPID の公開鍵>"
  subject    = "mailto:ops@example.com"
}

# 値を登録した任意シークレット(secrets.tf)
optional_secrets = ["smtp-pass", "google-maps-api-key", "gemini-api-key", "legacy-auth-salt", "vapid-private-key"]

# 監視・予算(monitoring.tf)。通知先のメールと、予算を作る請求先アカウント(空なら予算は作らない)
alert_emails       = ["ops@example.com"]
billing_account_id = ""
budget_amount      = 30000
