{
  "name": "katahimo-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.23.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "pnpm -r --parallel typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "build": "pnpm -r build",
    "dev": "pnpm -r --parallel dev",
    "db:generate": "pnpm --filter @katahimo/db generate",
    "db:migrate": "pnpm --filter @katahimo/db migrate",
    "db:seed": "pnpm --filter @katahimo/db seed",
    "db:studio": "pnpm --filter @katahimo/db studio"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.0",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
