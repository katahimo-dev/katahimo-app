{
  "name": "katahimo-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.23.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "pnpm -r --parallel typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "build": "pnpm -r build",
    "dev": "pnpm -r --parallel dev",
    "db:generate": "pnpm --filter @katahimo/db generate",
    "db:migrate": "pnpm --filter @katahimo/db migrate",
    "db:seed": "pnpm --filter @katahimo/api seed",
    "db:studio": "pnpm --filter @katahimo/db studio",
    "worker": "pnpm --filter @katahimo/worker start",
    "job:nightly-calendar-sync": "pnpm --filter @katahimo/worker job:nightly-calendar-sync",
    "job:csv-import": "pnpm --filter @katahimo/worker job:csv-import"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.10",
    "@types/node": "^22.10.0",
    "dotenv": "^16.6.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^5.0.1"
  }
}
