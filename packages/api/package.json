    "import:attendance": "tsx src/scripts/importAttendanceCsv.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.7",
    "@katahimo/core": "workspace:*",
    "@katahimo/db": "workspace:*",
    "@katahimo/ingestion": "workspace:*",
    "@katahimo/integrations": "workspace:*",
    "@katahimo/shared": "workspace:*",
    "@node-rs/argon2": "^2.0.2",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.45.3",
    "hono": "^4.6.14",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "tsup": "^8.3.5"
  }
}
