{
  "name": "@katahimo/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "build": "tsup",
    "seed": "tsx src/scripts/seed.ts",
    "import:reserva": "tsx src/scripts/importReservaCsv.ts",
