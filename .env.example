# ── データベース ─────────────────────────────────────────────
# アプリ本体は非所有者ロール(katahimo_app)で接続する。テーブル所有者はRLSを常にバイパス
# してしまうため、アプリがオーナーで繋ぐとRow Level Securityが一切効かなくなる
# (infra/initdb/01_bootstrap.sql でこのロールを作成済み)。
# ローカルにPostgreSQLを直接入れている場合(既定): ポート5432
DATABASE_URL=postgres://katahimo_app:katahimo_app@localhost:5432/katahimo_dev
# infra/docker-compose.yml を使う場合はポート5433
# DATABASE_URL=postgres://katahimo_app:katahimo_app@localhost:5433/katahimo_dev

# 本番(Cloud Run の Cloud SQL 接続)は Unix ソケット形式で書く(packages/db/src/connection.ts が変換する):
# DATABASE_URL=postgres://katahimo_app:<パスワード>@/katahimo?host=/cloudsql/<プロジェクト>:<リージョン>:<インスタンス>

# マイグレーション実行用(テーブル所有者)。DDL権限が必要なためRLSをバイパスできるオーナーで実行する
MIGRATION_DATABASE_URL=postgres://katahimo:katahimo@localhost:5432/katahimo_dev

# 接続プール(1プロセスあたり)。Cloud Run では「最大インスタンス数 × DB_POOL_MAX」+ワーカー・ジョブの分が
# Cloud SQL の max_connections を超えないようにする(doc/11 「接続数の見積もり」)。
# DB_POOL_MAX=10
# 使われていない接続を閉じるまでの秒数(0で閉じない)・接続の最大寿命(秒、未指定なら30〜60分)
# DB_IDLE_TIMEOUT_SEC=60
# DB_MAX_LIFETIME_SEC=

# ── サーバー ────────────────────────────────────────────────
PORT=8080
NODE_ENV=development
# Cookieセッションの署名鍵(本番はSecret Manager。本番は32文字以上必須)。openssl rand -hex 32 等で生成する
SESSION_SECRET=change-me-in-production
# ビルド済みWeb画面(pnpm --filter @katahimo/web build の出力)をAPIと同じサーバーから配信する場合の
# ディレクトリ。本番コンテナは /app/web。開発は Vite の開発サーバー(:5173)を使うため空のままでよい。
WEB_DIST_DIR=

# BlindIndexPortが使うマスターキー(32バイト=64桁hex)。CryptoPort(下記)とは
# 意図的に別の値にする(一方が漏れても他方に影響しない権限分離のため)。名前に反して本番でも使う
# (Secret Manager の katahimo-blind-index-key)。
# 生成例: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
LOCAL_DEV_MASTER_KEY=

# CryptoPortが使うテナントDEK(データ暗号化鍵)をラップするKEKの実装。
# テナントごとのDEKはDB(tenant_keysテーブル)にKEKでラップした状態のみ保存され、
# 平文DEKはプロセス内メモリにしか存在しない(エンベロープ暗号化)。
#   local: 下記 LOCAL_DEV_KEK(開発用のKMS代替) / gcp: Cloud KMS の鍵 GCP_KMS_KEY_NAME(本番は必須)
# 途中で切り替えると既存の tenant_keys を復号できなくなるため、環境ごとに最初に決めて変えないこと。
KMS_PROVIDER=local
# KMS_PROVIDER=local のKEK(32バイト=64桁hex)。
# 生成例: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
LOCAL_DEV_KEK=
# KMS_PROVIDER=gcp の鍵(projects/<p>/locations/<l>/keyRings/<r>/cryptoKeys/<k>)。実行SAに
# roles/cloudkms.cryptoKeyEncrypterDecrypter が必要。
GCP_KMS_KEY_NAME=

# ── 認証 ────────────────────────────────────────────────────
# GAS版 gas-childcare-visit-app のScript Properties AUTH_SALT と同じ値を入れる。
# 既存スタッフが今のパスワードのままログインできるようにするために必要(移行完了後は不要)。
LEGACY_AUTH_SALT=
# Google認証(OIDC)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8080/api/auth/google/callback

# ── Google連携 ──────────────────────────────────────────────
# 予定・ルート計算の実装(doc/api/schedule-route.md)。google / gas_bridge / noop。
# 未指定なら GOOGLE_MAPS_API_KEY と GOOGLE_APPLICATION_CREDENTIALS があれば google、
# GAS_BRIDGE_URL と GAS_BRIDGE_SECRET があれば gas_bridge、どちらも無ければ noop(常に予定なし)。
# Cloud Run(Workload Identity)では GOOGLE_APPLICATION_CREDENTIALS を使わないため明示すること。
SCHEDULE_PROVIDER=
# サービスアカウントキー(JSON)のパス。Cloud RunではWorkload Identityを使うため不要
GOOGLE_APPLICATION_CREDENTIALS=
# Google Maps Platform(Geocoding API + Routes API)のAPIキー。SCHEDULE_PROVIDER=google で必須
GOOGLE_MAPS_API_KEY=
# staff.calendar_id 以外に読むGoogleカレンダー(RESERVAの予約カレンダー等)。カンマ区切りで
# `カレンダーID` または `カレンダーID=持ち主のスタッフ名`(持ち主名を省略するとカレンダー名を使う)
GOOGLE_CALENDAR_IDS=
# ドメイン全体の委任で成り代わるWorkspaceユーザー(例: info@cutest.biz)。未指定ならカレンダーを
# サービスアカウントに共有する方式(推奨)。委任を使う場合はサービスアカウントキーが必要
GOOGLE_CALENDAR_IMPERSONATE=
# 稼働中のgas-childcare-visit-appのWeb Appデプロイ(Bridge.js)。GAS_BRIDGE_URLはその/exec
# エンドポイント、GAS_BRIDGE_SECRETはGAS側Script PropertiesのBRIDGE_API_SECRETと同じ値。
# SCHEDULE_PROVIDER=gas_bridge の予定取得と、outboxミラー書き込み(ワーカー)に使う。
GAS_BRIDGE_URL=
GAS_BRIDGE_SECRET=
# Gemini API。未設定の場合、日報/事故報告のAI生成・領収書OCRはGAS版と同じフォールバック応答
# (例: {"warnings":["API Key Missing"], ...})を返す(NoopReportAiPort)。
GEMINI_API_KEY=
# 日報/事故報告生成・領収書OCRに使うモデル名(未設定時はGAS版と同じデフォルト値を使う)。
GEMINI_MODEL_REPORT=
GEMINI_MODEL_OCR=

# Google Chat Incoming Webhook(日報/事故報告/領収書登録の通知)。GAS版GoogleChat.jsの
# Script Propertiesと同じ役割。未設定の場合は通知をスキップする。
GCHAT_REPORT_WEBHOOK_URL=
GCHAT_RECEIPT_WEBHOOK_URL=

# 【ワーカー用】パスワード再設定コードのメール送信(APIはoutboxに積むだけで、送信はワーカーが行う)(GAS版MailApp.sendEmailの置き換え)。SMTP_HOSTが空の場合、
# 開発環境では送信せずメール本文を標準出力に出す(本番では必須)。
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=保育日報 <noreply@example.com>

# 領収書画像の保存先。local: LOCAL_RECEIPT_STORAGE_DIR(開発用) / gcs: GCS_BUCKET(本番は必須。
# Cloud Run のローカルディスクはインスタンスと共に消えるため)。API とワーカーで同じ設定にする。
STORAGE_PROVIDER=local
LOCAL_RECEIPT_STORAGE_DIR=./data/receipts
GCS_BUCKET=

# ── 機能フラグ ──────────────────────────────────────────────
# スプレッドシート等へのミラー書き込みを行うか。Sheets脱却時に false にするだけでよい
# (falseの間はAPI側がoutboxへの積み込み自体を行わない。NoopMirrorPort参照)。
# trueにする場合、GAS_BRIDGE_URL/GAS_BRIDGE_SECRETに加え、Bridge.js側の書き込みaction
# (writeDailyReport等)のデプロイが必要(README「デプロイ手順」参照。現時点は未デプロイ)。
MIRROR_TO_GOOGLE_SHEETS=false
MIRROR_TO_GOOGLE_CALENDAR=false

# ── ワーカー(packages/worker、outboxミラー処理) ──────────────
# DATABASE_URL・KMS_PROVIDER/LOCAL_DEV_KEK/GCP_KMS_KEY_NAME・STORAGE_PROVIDER/LOCAL_RECEIPT_STORAGE_DIR/
# GCS_BUCKET・GAS_BRIDGE_URL/SECRETは上記API用の値をそのまま共有する。以下はワーカー固有の設定
# (省略時は下記の既定値)。
# OUTBOX_POLL_INTERVAL_MS=5000
# OUTBOX_BATCH_SIZE=10
# 失敗したミラーの再試行(最大試行回数・初回の待ち時間ms(以後倍々)・待ち時間の上限ms)
# OUTBOX_MAX_ATTEMPTS=8
# OUTBOX_RETRY_BASE_DELAY_MS=30000
# OUTBOX_RETRY_MAX_DELAY_MS=3600000
# ローカル開発用: 常駐ワーカーの中でも夜間ジョブを動かす(22:00 カレンダー反映 / 03:00 顧客CSV取込、JST)。
# 本番は Cloud Scheduler → Cloud Run Jobs(doc/api/attendance-batch.md)。
# WORKER_IN_PROCESS_CRON=false
# job:sync-busy-blocks が同期する期間(今日から何日先まで)
# BUSY_BLOCK_SYNC_DAYS=28
# 常駐ワーカーをヘルスチェック用に待ち受けさせるポート(Cloud Run サービス用。ローカルでは不要)
# WORKER_HEALTH_PORT=

# ── 顧客CSVの自動取込(API・ワーカー共通) ─────────────────────
# {"テナントslug":"DriveフォルダID"}。フォルダはサービスアカウントに閲覧共有しておく。
CUSTOMER_CSV_DRIVE_FOLDERS=
# ローカル開発用: <dir>/<テナントslug>/Kokyaku_YYYYMMDDHHmm_N.csv を取込元にする(Drive設定が無い場合のみ)。
CUSTOMER_CSV_LOCAL_DIR=
