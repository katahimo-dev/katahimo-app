# ── データベース ─────────────────────────────────────────────
# ロールは infra/initdb/00_create_database.sql が作る(doc/03_データベース設計.md 5章)。どのロールも RLS を
# バイパスできない(テーブルは FORCE ROW LEVEL SECURITY)。用途ごとに別のユーザーで接続する:
#   DATABASE_URL           … API(katahimo_app)
#   WORKER_DATABASE_URL    … ワーカー・ジョブ(katahimo_worker。outbox をテナント横断で取れる)
#   MIGRATION_DATABASE_URL … マイグレーション・テナントの作成(katahimo_migrator → 所有者 katahimo_owner)
# ローカルにPostgreSQLを直接入れている場合(既定): ポート5432
DATABASE_URL=postgres://katahimo_app:katahimo_app@localhost:5432/katahimo_dev
WORKER_DATABASE_URL=postgres://katahimo_worker:katahimo_worker@localhost:5432/katahimo_dev
# infra/docker-compose.yml を使う場合はポート5433
# DATABASE_URL=postgres://katahimo_app:katahimo_app@localhost:5433/katahimo_dev
# WORKER_DATABASE_URL=postgres://katahimo_worker:katahimo_worker@localhost:5433/katahimo_dev

# 本番(Cloud Run の Cloud SQL 接続)は Unix ソケット形式で書く(packages/db/src/connection.ts が変換する):
# DATABASE_URL=postgres://katahimo_app:<パスワード>@/katahimo?host=/cloudsql/<プロジェクト>:<リージョン>:<インスタンス>

# マイグレーション・テナントの作成(pnpm db:migrate / db:seed)。ログインすると所有者 katahimo_owner になる
MIGRATION_DATABASE_URL=postgres://katahimo_migrator:katahimo_migrator@localhost:5432/katahimo_dev

# 接続プール(1プロセスあたり)。Cloud Run では「最大インスタンス数 × DB_POOL_MAX」+ワーカー・ジョブの分が
# Cloud SQL の max_connections を超えないようにする(doc/07_インフラ・運用.md 2.1)。
# DB_POOL_MAX=10
# 使われていない接続を閉じるまでの秒数(0で閉じない)・接続の最大寿命(秒、未指定なら30〜60分)
# DB_IDLE_TIMEOUT_SEC=60
# DB_MAX_LIFETIME_SEC=

# ── サーバー ────────────────────────────────────────────────
PORT=8080
NODE_ENV=development
# Cookieセッションの署名鍵(本番はSecret Manager。本番は32文字以上必須)。openssl rand -hex 32 等で生成する
SESSION_SECRET=change-me-in-production
# ビルド済みWeb画面(pnpm --filter @katahimo/web build の出力)をAPIと同じサーバーから配信する場合の
# ディレクトリ。本番コンテナは /app/web。開発は Vite の開発サーバー(:5173)を使うため空のままでよい。
WEB_DIST_DIR=

# テナントの秘密値(管理者設定の Gemini API キー・Google Chat の Webhook URL)を tenant_secrets に保存するときの
# 封(暗号化)の実装。local: 下記 SECRET_BOX_LOCAL_KEY(開発用) / gcp: Cloud KMS の鍵 SECRET_BOX_KMS_KEY(本番は必須)。
# 鍵や実装を変えると保存済みの秘密値は開けなくなる(管理者設定で保存し直す)。API だけが使う。
SECRET_BOX_PROVIDER=local
# SECRET_BOX_PROVIDER=local の鍵(32バイト=64桁hex)。
# 生成例: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SECRET_BOX_LOCAL_KEY=
# SECRET_BOX_PROVIDER=gcp の鍵(projects/<p>/locations/<l>/keyRings/<r>/cryptoKeys/<k>)。API の実行SAに
# roles/cloudkms.cryptoKeyEncrypterDecrypter が必要(infra/gcp/kms.tf)。
SECRET_BOX_KMS_KEY=

# ── 認証 ────────────────────────────────────────────────────
# GAS版 gas-childcare-visit-app のScript Properties AUTH_SALT と同じ値を入れる。
# 既存スタッフが今のパスワードのままログインできるようにするために必要(移行完了後は不要)。
LEGACY_AUTH_SALT=

# ── Google連携 ──────────────────────────────────────────────
# 予定・ルート計算の実装(doc/05_バッチ・外部連携.md 4章)。google / gas_bridge / database / noop。
# 未指定なら GOOGLE_MAPS_API_KEY と GOOGLE_APPLICATION_CREDENTIALS があれば google、
# GAS_BRIDGE_URL・GAS_BRIDGE_SECRET・GAS_BRIDGE_TENANT があれば gas_bridge、どちらも無ければ noop(常に予定なし)。
# database は DB の予約(reservations)を予定にする(Google カレンダー・地図 API なし。区間は緯度経度からの目安)。明示したときだけ。
# Cloud Run(Workload Identity)では GOOGLE_APPLICATION_CREDENTIALS を使わないため明示すること。
SCHEDULE_PROVIDER=
# サービスアカウントキー(JSON)のパス。Cloud RunではWorkload Identityを使うため不要
GOOGLE_APPLICATION_CREDENTIALS=
# Google Maps Platform(Geocoding API + Routes API)のAPIキー。SCHEDULE_PROVIDER=google で必須
GOOGLE_MAPS_API_KEY=
# 共有カレンダー(RESERVAの予約カレンダー等)とスタッフに設定できるカレンダーは、テナントごとに運用担当者が
# `pnpm tenant:calendars` で設定する(doc/07_インフラ・運用.md)。
# ドメイン全体の委任で成り代わるWorkspaceユーザー(例: info@cutest.biz)。未指定ならカレンダーを
# サービスアカウントに共有する方式(推奨)。委任を使う場合はサービスアカウントキーが必要
GOOGLE_CALENDAR_IMPERSONATE=
# 稼働中のgas-childcare-visit-appのWeb Appデプロイ(Bridge.js)。GAS_BRIDGE_URLはその/exec
# エンドポイント、GAS_BRIDGE_SECRETはGAS側Script PropertiesのBRIDGE_API_SECRETと同じ値。
# SCHEDULE_PROVIDER=gas_bridge の予定取得と、outboxミラー書き込み(ワーカー)に使う。
# Bridge は1つのテナント(GAS版を使っている法人)の GAS・スプレッドシートにつながっているため、持ち主のテナントの slug を
# GAS_BRIDGE_TENANT に必ず一緒に設定する(3つ揃っていないと起動しない)。予定の取得・ミラーはそのテナントだけで、
# 別のテナントの予定は Bridge に求めず(502)、ミラーも積まない・送らない。
GAS_BRIDGE_URL=
GAS_BRIDGE_SECRET=
GAS_BRIDGE_TENANT=
# Gemini API。未設定の場合、日報/事故報告のAI生成・領収書OCRはGAS版と同じフォールバック応答
# (例: {"warnings":["API Key Missing"], ...})を返す(NoopReportAiPort)。
GEMINI_API_KEY=
# モデルは自動で選ぶ(日報・事故報告は Flash 系 → Flash-Lite 系、領収書OCRは Flash-Lite 系。doc/05 6章)。

# Google Chat Incoming Webhook(日報/事故報告/領収書登録の通知)。GAS版GoogleChat.jsの
# Script Propertiesと同じ役割。未設定の場合は通知をスキップする。
GCHAT_REPORT_WEBHOOK_URL=
GCHAT_RECEIPT_WEBHOOK_URL=

# 【ワーカー用】パスワード再設定コードのメール送信(APIはoutboxに積むだけで、送信はワーカーが行う)(GAS版MailApp.sendEmailの置き換え)。SMTP_HOSTが空の場合、
# 開発環境では送信せずメール本文を標準出力に出す(本番では必須)。
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=保育日報 <noreply@example.com>
# 【ワーカー用】画面の URL。管理者が送る「パスワード設定の案内」のメールに、法人IDつきのログイン画面の URL として書く
# (空なら URL は書かず法人IDだけ)。
APP_PUBLIC_URL=

# 領収書画像の保存先。local: LOCAL_RECEIPT_STORAGE_DIR(開発用) / gcs: GCS_BUCKET(本番は必須。
# Cloud Run のローカルディスクはインスタンスと共に消えるため)。API とワーカーで同じ設定にする。
STORAGE_PROVIDER=local
LOCAL_RECEIPT_STORAGE_DIR=./data/receipts
GCS_BUCKET=

# ── 通知(Web Push) ─────────────────────────────────────────
# 翌日の予定のお知らせ・テスト通知(doc/05_バッチ・外部連携.md)。鍵は `pnpm push:vapid-keys` で作る。
# 3つとも空なら通知は使わない(設定画面に「通知」の欄が出ず、お知らせのジョブは何もしない)。
# VAPID_PUBLIC_KEY は API とワーカーの両方、VAPID_PRIVATE_KEY・VAPID_SUBJECT はワーカーだけが使う。
# 鍵を作り直すと、端末の購読は全て使えなくなる(スタッフが通知をオンにし直す)。
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# プッシュサービスからの連絡先(mailto: か https:。例: mailto:ops@example.com)
VAPID_SUBJECT=

# ── 機能フラグ ──────────────────────────────────────────────
# スプレッドシート等へのミラー書き込みを行うか。Sheets脱却時に false にするだけでよい
# (false の間は API がミラーのトピックを outbox に積まず、ワーカーも残っているものを送らずに完了にする)。
# ミラーするのは GAS_BRIDGE_TENANT のテナントだけ(他のテナントの記録は積まない・送らない)。
# API とワーカーで同じ値にする。
# trueにする場合、GAS_BRIDGE_URL/GAS_BRIDGE_SECRET/GAS_BRIDGE_TENANTに加え、GAS版に Bridge.js Ver. 1.1.38 以降
# (書き込みaction writeDailyReport 等)をデプロイしておく(doc/05_バッチ・外部連携.md「GAS Bridge」)。
MIRROR_TO_GOOGLE_SHEETS=false

# ── outbox の処理(outbox-drain の起動) ─────────────────────────
# 【API用】outbox に積んだ操作のコミットの後に実行を頼む Cloud Run のジョブ
# (projects/<プロジェクト>/locations/<リージョン>/jobs/katahimo-outbox-drain。doc/05_バッチ・外部連携.md 2章)。本番は必須。
# ローカル開発では空のままにし、outbox は `pnpm worker`(ローカル専用の見回り)か `pnpm outbox:once` で処理する。
OUTBOX_DRAIN_JOB=

# ── ワーカー(packages/worker) ───────────────────────────────
# STORAGE_PROVIDER/LOCAL_RECEIPT_STORAGE_DIR/GCS_BUCKET・
# SCHEDULE_PROVIDER 等・GAS_BRIDGE_URL/SECRET/TENANT・MIRROR_* は API と同じ値を使う(packages/integrations の
# sharedEnvShape)。以下はワーカー(ジョブ・pnpm worker)固有の設定(省略時は下記の既定値)。
# outbox: 1回の実行で続けて処理する最大件数・1件のリース(ms)
# OUTBOX_DRAIN_MAX=500
# OUTBOX_LEASE_MS=300000
# 失敗したメッセージの再試行(初回の待ち時間ms(以後倍々)・待ち時間の上限ms)。試行回数の上限はメッセージごと。
# 本番では待ち時間を過ぎたものを outbox-drain の見回り(10分ごと)が取るため、実際の間隔は次の見回りまで延びる
# OUTBOX_RETRY_BASE_DELAY_MS=30000
# OUTBOX_RETRY_MAX_DELAY_MS=3600000
# pnpm worker(ローカル開発専用の見回り)だけ: 空になった後、次に見に行くまでの間隔(ms)
# OUTBOX_POLL_INTERVAL_MS=5000
# 停止の合図から強制終了までの時間(ms)・1回だけのジョブの上限時間(ms)・操作ログを残す月数
# WORKER_SHUTDOWN_TIMEOUT_MS=8000
# JOB_TIMEOUT_MS=1800000
# APP_LOG_RETENTION_MONTHS=13
# job:sync-busy-blocks が同期する期間(今日から何日先まで)
# BUSY_BLOCK_SYNC_DAYS=28

# ── 顧客CSVの自動取込(API・ワーカー共通) ─────────────────────
# 取込元の Drive のフォルダはテナントごとに運用担当者が `pnpm tenant:customer-source -- <slug> --drive-folder <ID>` で
# 設定する(platform.tenants.customer_import_settings。フォルダはサービスアカウントに閲覧共有しておく)。
# ローカル開発用: 取込元の設定の無いテナントは <dir>/<テナントslug>/Kokyaku_YYYYMMDDHHmm.csv(末尾に _N が
# 付くこともある)を取込元にする。
# 本番(NODE_ENV=production)で設定すると API・ワーカーは起動しない。
CUSTOMER_CSV_LOCAL_DIR=
