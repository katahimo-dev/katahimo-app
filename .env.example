# ── データベース ─────────────────────────────────────────────
# アプリ本体は非所有者ロール(katahimo_app)で接続する。テーブル所有者はRLSを常にバイパス
# してしまうため、アプリがオーナーで繋ぐとRow Level Securityが一切効かなくなる
# (infra/initdb/01_bootstrap.sql でこのロールを作成済み)。
# ローカルにPostgreSQLを直接入れている場合(既定): ポート5432
DATABASE_URL=postgres://katahimo_app:katahimo_app@localhost:5432/katahimo_dev
# infra/docker-compose.yml を使う場合はポート5433
# DATABASE_URL=postgres://katahimo_app:katahimo_app@localhost:5433/katahimo_dev

# マイグレーション実行用(テーブル所有者)。DDL権限が必要なためRLSをバイパスできるオーナーで実行する
MIGRATION_DATABASE_URL=postgres://katahimo:katahimo@localhost:5432/katahimo_dev

# ── サーバー ────────────────────────────────────────────────
PORT=8080
NODE_ENV=development
# Cookieセッションの署名鍵(本番はSecret Manager)。openssl rand -hex 32 等で生成する
SESSION_SECRET=change-me-in-production

# BlindIndexPortの開発用実装が使うマスターキー(32バイト=64桁hex)。CryptoPort(下記)とは
# 意図的に別の値にする(一方が漏れても他方に影響しない権限分離のため)。
# 生成例: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
LOCAL_DEV_MASTER_KEY=

# CryptoPortが使うテナントDEK(データ暗号化鍵)をラップするKEK(32バイト=64桁hex)。
# テナントごとのDEKはDB(tenant_keysテーブル)にこのKEKでラップした状態のみ保存され、
# 平文DEKはプロセス内メモリにしか存在しない(エンベロープ暗号化)。本番はCloud KMSに
# 置き換える(Phase 5、実際のGCPプロジェクト・KMSキーリングが用意でき次第)。
# 生成例: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
LOCAL_DEV_KEK=

# ── 認証 ────────────────────────────────────────────────────
# GAS版 gas-childcare-visit-app のScript Properties AUTH_SALT と同じ値を入れる。
# 既存スタッフが今のパスワードのままログインできるようにするために必要(移行完了後は不要)。
LEGACY_AUTH_SALT=
# Google認証(OIDC)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8080/api/auth/google/callback

# ── Google連携 ──────────────────────────────────────────────
# 予定・ルート計算の実装(doc/api/schedule-route.md)。google / gas_bridge / noop。
# 未指定なら GOOGLE_MAPS_API_KEY と GOOGLE_APPLICATION_CREDENTIALS があれば google、
# GAS_BRIDGE_URL と GAS_BRIDGE_SECRET があれば gas_bridge、どちらも無ければ noop(常に予定なし)。
# Cloud Run(Workload Identity)では GOOGLE_APPLICATION_CREDENTIALS を使わないため明示すること。
SCHEDULE_PROVIDER=
# サービスアカウントキー(JSON)のパス。Cloud RunではWorkload Identityを使うため不要
GOOGLE_APPLICATION_CREDENTIALS=
# Google Maps Platform(Geocoding API + Routes API)のAPIキー。SCHEDULE_PROVIDER=google で必須
GOOGLE_MAPS_API_KEY=
# staff.calendar_id 以外に読むGoogleカレンダー(RESERVAの予約カレンダー等)。カンマ区切りで
# `カレンダーID` または `カレンダーID=持ち主のスタッフ名`(持ち主名を省略するとカレンダー名を使う)
GOOGLE_CALENDAR_IDS=
# ドメイン全体の委任で成り代わるWorkspaceユーザー(例: info@cutest.biz)。未指定ならカレンダーを
# サービスアカウントに共有する方式(推奨)。委任を使う場合はサービスアカウントキーが必要
GOOGLE_CALENDAR_IMPERSONATE=
# 稼働中のgas-childcare-visit-appのWeb Appデプロイ(Bridge.js)。GAS_BRIDGE_URLはその/exec
# エンドポイント、GAS_BRIDGE_SECRETはGAS側Script PropertiesのBRIDGE_API_SECRETと同じ値。
# SCHEDULE_PROVIDER=gas_bridge の予定取得と、outboxミラー書き込み(ワーカー)に使う。
GAS_BRIDGE_URL=
GAS_BRIDGE_SECRET=
# Gemini API。未設定の場合、日報/事故報告のAI生成・領収書OCRはGAS版と同じフォールバック応答
# (例: {"warnings":["API Key Missing"], ...})を返す(NoopReportAiPort)。
GEMINI_API_KEY=
# 日報/事故報告生成・領収書OCRに使うモデル名(未設定時はGAS版と同じデフォルト値を使う)。
GEMINI_MODEL_REPORT=
GEMINI_MODEL_OCR=

# Google Chat Incoming Webhook(日報/事故報告/領収書登録の通知)。GAS版GoogleChat.jsの
# Script Propertiesと同じ役割。未設定の場合は通知をスキップする。
GCHAT_REPORT_WEBHOOK_URL=
GCHAT_RECEIPT_WEBHOOK_URL=

# パスワード再設定コードのメール送信(GAS版MailApp.sendEmailの置き換え)。SMTP_HOSTが空の場合、
# 開発環境では送信せずメール本文を標準出力に出す(本番では必須)。
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=保育日報 <noreply@example.com>

# 領収書画像の保存先(ローカル開発用ファイルシステムパス)。本番はGCS(Phase 5)に置き換える。
LOCAL_RECEIPT_STORAGE_DIR=./data/receipts

# ── 機能フラグ ──────────────────────────────────────────────
# スプレッドシート等へのミラー書き込みを行うか。Sheets脱却時に false にするだけでよい
# (falseの間はAPI側がoutboxへの積み込み自体を行わない。NoopMirrorPort参照)。
# trueにする場合、GAS_BRIDGE_URL/GAS_BRIDGE_SECRETに加え、Bridge.js側の書き込みaction
# (writeDailyReport等)のデプロイが必要(README「デプロイ手順」参照。現時点は未デプロイ)。
MIRROR_TO_GOOGLE_SHEETS=false
MIRROR_TO_GOOGLE_CALENDAR=false

# ── ワーカー(packages/worker、outboxミラー処理) ──────────────
# DATABASE_URL・LOCAL_DEV_KEK・LOCAL_RECEIPT_STORAGE_DIR・GAS_BRIDGE_URL/SECRETは
# 上記API用の値をそのまま共有する。以下はワーカー固有の設定(省略時は下記の既定値)。
# OUTBOX_POLL_INTERVAL_MS=5000
# OUTBOX_BATCH_SIZE=10
